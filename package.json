{
  "name": "ac27-editor",
  "version": "1.2.7",
  "description": "Cross-platform Level Editor for Airport Control 27 .acl flight schedules",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "node tests/run-all.mjs",
    "build": "vite build",
    "build:win": "vite build && node build.js --win",
    "build:win:voice": "vite build && node build.js --win --voice",
    "build:mac": "vite build && node build.js --mac",
    "build:all": "vite build && node build.js --win --mac"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "ffmpeg-static": "^5.3.0",
    "koffi": "^3.1.4",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "zustand": "^5.0.14"
  }
}
